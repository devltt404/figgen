{
  "name": "figgen",
  "version": "0.1.0",
  "description": "Figma-to-code multi-agent pipeline",
  "private": true,
  "type": "module",
  "scripts": {
    "pipeline": "tsx src/pipeline.ts",
    "server": "nodemon --exec tsx src/server.ts --ext ts --ignore sandbox/ --ignore output/ --ignore ui/",
    "ui": "npm run dev --prefix ui",
    "dev": "concurrently -n server,ui -c \"#ea580c,#3b82f6\" \"npm run server\" \"npm run ui\"",
    "typecheck": "tsc --noEmit",
    "eval": "tsx evaluate/run-eval.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "dotenv": "^16.4.5",
    "jsonrepair": "^3.14.0",
    "openai": "latest",
    "playwright": "^1.52.0",
    "pngjs": "^7.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "@types/pngjs": "^6.0.5",
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.0",
    "tsx": "^4.21.0",
    "typescript": "^5.4.5"
  }
}
