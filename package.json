{
  "name": "figgen",
  "version": "0.1.0",
  "description": "Figma-to-code multi-agent system",
  "private": true,
  "type": "module",
  "scripts": {
    "pipeline": "tsx src/pipeline.ts",
    "server": "nodemon --exec tsx src/server.ts --ext ts --ignore sandbox/ --ignore output/ --ignore ui/",
    "ui": "npm run dev --prefix ui",
    "dev": "concurrently -n server,ui -c \"#ea580c,#3b82f6\" \"npm run server\" \"npm run ui\"",
    "typecheck": "tsc --noEmit",
    "test:diff": "tsx scripts/test-diff.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "latest",
    "@mastra/core": "latest",
    "@mastra/mcp": "latest",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^16.4.5",
    "figma-developer-mcp": "^0.8.1",
    "ollama-ai-provider": "^1.2.0",
    "openai": "latest",
    "playwright": "^1.52.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.12.12",
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.0",
    "express": "^5.2.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.4.5"
  }
}
